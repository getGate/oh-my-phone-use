# Seeed Studio XIAO ESP32S3 (ESP32-S3, 8 MB flash). Merged after sdkconfig.defaults when the
# target is esp32s3. BLE only: the S3 has no Classic Bluetooth, so the HFP builds do not apply.
# The board has no USB-UART bridge: the serial protocol runs on the chip's USB Serial/JTAG port
# (/dev/cu.usbmodem*).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
